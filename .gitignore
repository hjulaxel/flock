# Both spellings on purpose. `node_modules/` matches a directory and NOT a
# symlink, so working in a `git worktree` — where the usual trick is to symlink
# node_modules at the real checkout instead of installing twice — leaves the link
# itself untracked-but-not-ignored, and one `git add -A` commits an absolute path
# from somebody's machine.
node_modules
node_modules/
out/
dist/
.vscode-test/
*.vsix

# macOS
.DS_Store

# Local Claude Code settings — machine-specific, contains absolute paths.
.claude/settings.local.json

# Internal planning docs — private, kept locally only.
SPEC.md
STATUS.md
