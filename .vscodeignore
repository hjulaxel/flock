# Not part of the extension — a standalone CLI + hooks plugin, tested by
# running it, not by installing the vsix.
prototype/**
# The README links into docs/ — those links resolve against the repository on
# the marketplace page, so the files themselves do not need to ship.
docs/**
# Design notes are written for the repository, not the package: the README
# never links to them, and they record decisions rather than anything the
# extension reads at runtime.
design/**
**/*.map
**/*.ts
!dist/extension.js

# Secrets. `.gitignore` keeps `.env` out of git; this keeps it out of the
# PACKAGE, which is a different door to the same file — the token would have
# shipped to the marketplace inside the vsix. vsce refuses to build without
# this, and it is right to.
.env
.env.*
